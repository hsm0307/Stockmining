# 이 파일을 .env 로 복사한 뒤 값을 채우세요. (.env 는 git 에 올라가지 않습니다)
KRX_API_KEY=여기에_KRX_Open_API_인증키

# 선택 설정
# KRX_START=20160101          # 수집 시작일
# KRX_API_SLEEP=0.15          # API 호출 간격(초)
# KRX_ROUND_TRIP_COST=0.0025  # 왕복 거래비용 가정 (세금+수수료+슬리피지)
# KRX_LIMIT_RULE=exact        # 상한가 판정: exact(규정 계산) | loose(등락률 29.5% 기준도 허용)
